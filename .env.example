# ── Supabase ──
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Platform Admin / Official Accounts ──
# Comma-separated (lowercase recommended)
VITE_PLATFORM_ADMIN_EMAILS=admin@yourdomain.com
VITE_OFFICIAL_ACCOUNT_EMAILS=admin@yourdomain.com,official@yourdomain.com

# ── Cloudinary ──
VITE_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
VITE_CLOUDINARY_UPLOAD_PRESET=zikshare_unsigned

# ── Paystack ──
VITE_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY_HERE
# Server-only secrets below must be configured in Supabase Edge Function secrets / Vercel env, never in client code.
PAYSTACK_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
PLATFORM_ADMIN_EMAILS=admin@yourdomain.com
